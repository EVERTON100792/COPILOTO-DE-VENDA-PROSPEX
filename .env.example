# ============ PROSPEX AUTOPILOT — Variáveis de ambiente ============
# Copie para .env.local e preencha. Todas opcionais (modo DEMO default).

# Demo (default true): usa dados fictícios e simula envios.
VITE_DEMO_MODE=true

# IA — OpenRouter (formato OpenAI), OpenAI-compat ou Anthropic
# VITE_AI_PROVIDER=openrouter
# VITE_AI_API_KEY=
# VITE_AI_MODEL=deepseek/deepseek-chat
# VITE_AI_BASE_URL=https://openrouter.ai/api/v1
#
# ATENÇÃO (produção Netlify):
# - VITE_AI_API_KEY é EMBUTIDA no bundle JS pelo Vite (expõe a chave no navegador).
#   Use apenas localmente (dev) ou como chave default.
# - No Netlify, defina a chave como AI_API_KEY (SERVIDOR) e NUNCA como VITE_AI_API_KEY:
#   a função netlify/functions/opencode.js injeta a chave no lado do servidor.
# - VITE_AI_BASE_URL e VITE_AI_MODEL podem ser definidas no Netlify (não são secretas).

# Busca (SerpAPI ou Google CSE)
# VITE_SEARCH_PROVIDER=serpapi
# VITE_SEARCH_API_KEY=

# Google Maps / Places (enriquecimento + Real Discovery — fonte de busca real)
# Sem esta chave, o modo REAL de busca fica bloqueado (nunca usa mock como real).
# Também pode ser salva pela tela /integrations (localStorage, mascarada).
# VITE_MAPS_API_KEY=

# E-mail (Resend | sendgrid | smtp)
# VITE_EMAIL_PROVIDER=resend
# VITE_EMAIL_API_KEY=

# WhatsApp (meta-cloud | evolution)
# VITE_WHATSAPP_PROVIDER=meta-cloud
# VITE_WHATSAPP_API_KEY=
# VITE_WHATSAPP_PHONE_ID=

# Supabase (capacidade persistência e banco)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=